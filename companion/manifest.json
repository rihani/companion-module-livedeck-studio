{
	"$schema": "../node_modules/@companion-module/base/assets/manifest.schema.json",
	"type": "connection",
	"id": "livedeck-studio",
	"name": "LiveDeck",
	"shortname": "livedeck-studio",
	"description": "Control the LiveDeck vision mixer (iPad, iPhone, Mac, Android): take and cue layouts, GO LIVE, transitions, recording, NDI / RTMP / HLS outputs, PTZ presets, audio, Run a Show and talkback, with live button feedback.",
	"version": "0.0.0",
	"license": "MIT",
	"repository": "git+https://github.com/rihani/companion-module-livedeck-studio.git",
	"bugs": "https://github.com/rihani/companion-module-livedeck-studio/issues",
	"maintainers": [
		{
			"name": "rihani",
			"github": "rihani"
		}
	],
	"legacyIds": ["livedeck"],
	"runtime": {
		"type": "node22",
		"api": "nodejs-ipc",
		"apiVersion": "0.0.0",
		"entrypoint": "../dist/main.js"
	},
	"manufacturer": "Manar Labs",
	"products": ["LiveDeck"],
	"keywords": [
		"NDI",
		"switcher",
		"video mixer",
		"vision mixer",
		"PTZ",
		"live streaming",
		"RTMP",
		"recording",
		"talkback",
		"iPad",
		"Android"
	],
	"bonjourQueries": {
		"bonjour_host": {
			"type": "livedeck-api",
			"protocol": "tcp",
			"txt": {
				"role": "studio"
			},
			"addressFamily": "ipv4"
		}
	}
}
